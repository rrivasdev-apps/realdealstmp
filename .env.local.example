# Copy to .env.local and fill in real values. Never commit .env.local.

# Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only: bypasses Row Level Security. Only use in trusted server code
# (never expose to the client, never prefix with NEXT_PUBLIC_).
SUPABASE_SERVICE_ROLE_KEY=

# Server-only: used by backend routes that call the Anthropic API directly.
ANTHROPIC_API_KEY=

# Server-only: used by src/app/api/places/* to proxy Google's Places API (New) for
# deal-address autocomplete. Optional -- if unset, address entry falls back to plain
# manual fields (see src/components/address-fields.tsx).
GOOGLE_MAPS_API_KEY=

# Server-only: shared secret that gates src/app/api/cron/automations (the
# date_based-trigger / stalled-process sweep for Deal Automations). Vercel Cron sends
# this automatically as an Authorization: Bearer header once set here and in vercel.json;
# any other scheduler must send the same header. Pick any long random string.
CRON_SECRET=
